pair_style      lj/cut/coul/long 12.0
pair_modify     mix arithmetic tail yes
kspace_style    pppm 1.0e-5
pair_coeff      1 1 0.053649 2.80
pair_coeff      2 2 0.156973 3.05
bond_style      harmonic
bond_coeff      1 0.0 1.16
angle_style     harmonic
angle_coeff     1 0.0 180.0
mass            1 12.0107
mass            2 15.9994
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# equilibration: every step attempt on average 50 molecule translations
# or rotations, 100 molecule exchanges, and 2 volume exchanges, and adjust
# the maximum displacement, rotation angle, and volume change

#   args:        N  M  X   V  T    displace maxdlogvolratio seed
fix             mc all gemc 1  50 100 2  ${T} 0.5      0.1             7771                 mol co2mol maxangle 30 tune 20 0.4 0.4
fix             mc all gemc 1  50 100 2  250.0 0.5      0.1             7771                 mol co2mol maxangle 30 tune 20 0.4 0.4
compute_modify  thermo_temp dynamic/dof yes

variable        nmol equal atoms/3
thermo_style    custom step v_nmol vol pe density f_mc[1] f_mc[2] f_mc[3]                 f_mc[4] f_mc[5] f_mc[6] f_mc[7] f_mc[8] f_mc[11]
thermo_modify   norm no
thermo          50
run             ${neq}
run             200
