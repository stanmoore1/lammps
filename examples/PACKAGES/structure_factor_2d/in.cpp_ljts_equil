# CPP LJTS equilibration phase (INTEL package, double precision).  Equilibrates the
# field-pinned two-phase density wave, then writes a restart for the production phase
# (which uses OPENMP because the INTEL package cannot produce the per-atom virials
# needed for the Harasima pressure contour).
#
# Run:  lmp -sf intel -pk intel 0 omp <n> mode double -in in.cpp_ljts_equil \
#           -var T <T> -var dUmax <dU> -var seed <s> -var tag <name>

variable        T       index 0.98
variable        dUmax   index 0.4
variable        rho     index 0.31
variable        seed    index 12345
variable        tag     index run
variable        Nequil  index 1000000
variable        aspect  equal 3.0

units           lj
atom_style      atomic

variable        Natoms  equal 1000
variable        vol     equal ${Natoms}/${rho}
variable        lxv     equal (${vol}/${aspect})^(1.0/3.0)
variable        lzv     equal ${aspect}*${lxv}
region          box block 0 ${lxv} 0 ${lxv} 0 ${lzv} units box
create_box      1 box
create_atoms    1 random ${Natoms} ${seed} NULL overlap 0.9 maxtry 2000
mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift yes                # truncated+shifted (PeTS), no tail correction
neighbor        0.3 bin
neigh_modify    every 10 delay 0 check yes

minimize        1.0e-4 1.0e-6 1000 10000
reset_timestep  0
velocity        all create ${T} ${seed} rot yes dist gaussian
timestep        0.005
fix             1 all nvt temp ${T} ${T} 0.5

variable        AF      equal ${dUmax}/2.0
variable        forcez  atom 2*PI*${AF}*sin(2*PI*z/lz)/lz
fix             ext all addforce 0.0 0.0 v_forcez

thermo          50000
thermo_style    custom step temp pe etotal press pzz
run             ${Nequil}

write_restart   ${tag}.equil.restart
print           "EQUIL DONE tag ${tag} T ${T} dUmax ${dUmax}  Lx $(lx) Lz $(lz) N $(count(all))"
