# CPP simulation 1 (dissertation Table 3.1): supercritical LJ, induced density wave
# Reproduces the apparent (induced) surface tension via pressure-tensor, VdW, and TZ.
#
# Parameters (Table 3.1, sim 1): Type SC, N=2000, aspect Lz/(Lx=Ly)=2, T*=1.5,
# rho_avg=0.437 (rho_min 0.043 -> rho_max 0.749), dUmax=5.0, 5e6 steps.
# External potential U_ext(z) = (dUmax/2) cos(2 pi z / Lz)  (Eq. 3.36), applied as a
# force F_z = -dU/dz = (dUmax*pi/Lz) sin(2 pi z/Lz) via fix addforce, with
# AF = dUmax/2 so that F_z = 2*pi*AF*sin(2 pi z/Lz)/Lz.
#
# Inhomogeneity is along z (the long axis), matching compute structure/factor/2d.

# ----- adjustable -----
variable        T      index 1.5        # T* (supercritical; Tc ~ 1.326). override: -var T X
variable        rho    equal 0.437      # rho_avg
# dUmax: dissertation sim 1 uses 5.0 (with rcut=5.5).  With the truncated rcut=2.5
# potential that field drives vacuum-to-solid; use a milder field so the density
# gradient stays small (gradient-theory regime, well-conditioned OZ inversion).
variable        dUmax  index 1.0        # max external potential difference (override: -var dUmax X)
# Cutoff: 5.5 sigma as in the dissertation (truncated forces, no tail correction
# during the run; apply the local LRC in post-processing via plot_muih.py
# --lrc-rcut 5.5 when comparing against the full-LJ EOS).
variable        RCUT   index 5.5        # cutoff (override: -var RCUT X)
variable        NBIN   equal 200        # z-bins for density/pressure profiles
variable        KMAX   equal 8          # structure-factor reciprocal cutoff
variable        SFBIN  equal 40         # z-bins for the structure factor (OZ matrix)
variable        Nequil index 50000      # field-off equilibration (overridable: -var Nequil N)
variable        Nfield index 100000     # field-on equilibration (discard)
variable        Nprod  index 500000     # production
# ----------------------

variable        AF     equal ${dUmax}/2.0

units           lj
atom_style      atomic

# sc lattice at rho gives 1 atom/site: 10 x 10 x 20 sites = 2000 atoms, aspect 2
lattice         sc ${rho}
region          box block 0 10 0 10 0 20
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create ${T} 87287 rot yes dist gaussian

pair_style      lj/cut ${RCUT}
pair_coeff      1 1 1.0 1.0 ${RCUT}
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

timestep        0.002
fix             1 all nvt temp ${T} ${T} 1.0

# field-off equilibration
thermo          5000
run             ${Nequil}

# apply the external field and equilibrate
variable        forcez atom 2*PI*${AF}*sin(2*PI*z/lz)/lz
fix             ext all addforce 0.0 0.0 v_forcez
run             ${Nfield}

# ----- production measurements -----
reset_timestep  0

# density profile rho(z); bin WIDTH = 1/NBIN in reduced units -> NBIN bins
variable        dzr equal 1.0/${NBIN}
compute         cz all chunk/atom bin/1d z lower ${dzr} units reduced
fix             den all ave/chunk 10 5000 50000 cz density/number file cpp1_density.out

# per-atom configurational stress (pair only: excludes the external-field virial
# and the kinetic term, which cancels in PN-PT) -> pressure-tensor profile.
# norm none gives the SUMMED stress per bin, so P_aa(z) = -sum(stress)/V_bin.
compute         s all stress/atom NULL pair
fix             prof all ave/chunk 10 5000 50000 cz c_s[1] c_s[2] c_s[3] norm none file cpp1_stress.out

# global pressure tensor for the induced surface tension (pair virial only, so the
# fix addforce external-field virial is NOT included)
compute         press all pressure NULL pair
variable        pN  equal c_press[3]
variable        pT  equal 0.5*(c_press[1]+c_press[2])
variable        gam equal lz*(v_pN-v_pT)
fix             gt all ave/time 10 5000 50000 v_pN v_pT v_gam file cpp1_gamma.out

# bin-resolved structure factor for the OZ / TZ method
compute         sf all structure/factor/2d ${KMAX} ${SFBIN}
fix             sfavg all ave/time 10 5000 50000 c_sf[*] mode vector file cpp1_sf.out

thermo          10000
thermo_style    custom step temp press pxx pyy pzz v_gam
run             ${Nprod}

print           "BOX Lx $(lx) Ly $(ly) Lz $(lz)  N $(count(all))  rho $(count(all)/vol)"
