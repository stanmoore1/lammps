# CPP "torture test": N=100, cubic box, T*=1.1*Tc=1.198 (supercritical), dUmax=2.
# Huge density gradients with brutal small-N statistics -> run 1e7 steps and throw
# every EOS-recovery method at it.  Measures everything: rho(z), S_ij(k), Harasima
# (stress/atom) and IK (stress/cartesian) pressure contours, energy, mechanical gamma.

variable        T       index 1.198
variable        dUmax   index 2.0
variable        rho     index 0.31
variable        Natoms  index 100
variable        Nequil  index 100000
variable        Nprod   index 10000000
variable        tag     index cube100
variable        NBIN    equal 50          # fine density/stress profile bins
variable        KMAX    equal 6           # structure-factor reciprocal cutoff
variable        SFBIN   equal 16          # structure-factor z-bins (OZ matrix)

units           lj
atom_style      atomic

# cubic box
variable        vol     equal ${Natoms}/${rho}
variable        L       equal (${vol})^(1.0/3.0)
region          box block 0 ${L} 0 ${L} 0 ${L} units box
create_box      1 box
create_atoms    1 random ${Natoms} 12345 NULL overlap 0.9 maxtry 5000
mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift yes
neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes

minimize        1.0e-4 1.0e-6 1000 10000
reset_timestep  0
velocity        all create ${T} 12345 rot yes dist gaussian
timestep        0.005
fix             1 all nvt temp ${T} ${T} 0.5
variable        AF      equal ${dUmax}/2.0
variable        forcez  atom 2*PI*${AF}*sin(2*PI*z/lz)/lz
fix             ext all addforce 0.0 0.0 v_forcez

# the strong field pins all atoms into a thin z-slab -> rebalance the z cut-planes
# across ranks (shift, not tiled) so MPI runs aren't bottlenecked by one rank
fix             bal all balance 10000 1.1 shift z 10 1.05

thermo          20000
thermo_style    custom step temp pe press pzz
run             ${Nequil}
reset_timestep  0

variable        dzr     equal 1.0/${NBIN}
variable        dzb     equal lz/${NBIN}
compute         cz all chunk/atom bin/1d z lower ${dzr} units reduced

# density profile rho(z)  (field-coupling + contours)
fix             den all ave/chunk 50 20000 1000000 cz density/number file ${tag}_dens.out

# bin-resolved planar structure factor S_ij(k)  (DCF / OZ inversion, TZ)
compute         sf all structure/factor/2d ${KMAX} ${SFBIN}
fix             sfavg all ave/time 50 20000 1000000 c_sf[1] c_sf[2] c_sf[3] c_sf[4] c_sf[5] &
                mode vector file ${tag}_sf.out

# Harasima (H) contour: per-atom pair virial binned in z
compute         sa all stress/atom NULL pair
fix             hpr all ave/chunk 50 20000 1000000 cz c_sa[1] c_sa[2] c_sa[3] norm none file ${tag}_hstress.out

# Irving-Kirkwood (IK) contour: stress/cartesian (kinetic + configurational)
compute         ik all stress/cartesian z ${dzb} NULL ${dzb}
fix             ikpr all ave/time 200 5000 1000000 c_ik[1] c_ik[2] c_ik[3] c_ik[4] c_ik[5] c_ik[6] c_ik[7] c_ik[8] &
                mode vector file ${tag}_ikstress.out

# energy density u(z)
compute         pe all pe/atom
fix             epr all ave/chunk 50 20000 1000000 cz c_pe norm none file ${tag}_energy.out

# global mechanical surface tension (pair virial)
compute         press all pressure NULL pair
variable        pN  equal c_press[3]
variable        pT  equal 0.5*(c_press[1]+c_press[2])
variable        gam equal lz*(v_pN-v_pT)/2.0
fix             gt all ave/time 100 10000 1000000 v_pN v_pT v_gam file ${tag}_gamma.out

run             ${Nprod}
print           "CUBE100 DONE tag ${tag} T ${T} dUmax ${dUmax} L $(lx) N $(count(all)) rho_avg $(count(all)/vol)"
