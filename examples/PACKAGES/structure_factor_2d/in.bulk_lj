# Bulk Lennard-Jones liquid: bin-resolved planar structure factor S_ij(k_parallel)
# Proof-of-concept input for the Ornstein-Zernike inversion described in
# examples/PACKAGES/structure_factor_2d/README.
#
# The box is cubic, so Lx == Ly (required by compute structure/factor/2d).
# Because the fluid is homogeneous, the inverted direct correlation function
# C_ij(k) must be translationally invariant in z; its z-Fourier transform
# recovers the bulk c(k), which is cross-checked against (1 - 1/S(q))/rho from
# the radial distribution function (rdf_bulk.out).

units           lj
atom_style      atomic

# Default state point is a dense liquid: S(q) is small and smooth there, so the
# rdf-based (1-1/S)/rho cross-check is reliable.  (Near-critical points, e.g.
# rho=0.437 T=1.5, have huge S(q) and a long-ranged g(r) that the finite rdf
# cutoff truncates badly -- not a good validation target.)
variable        rho   index 0.85      # reduced number density
variable        temp  index 1.5       # reduced temperature
variable        kmax  index 8         # max reciprocal-lattice index (circular cutoff)
variable        nbins index 8         # number of z-bins
variable        rcut  index 2.5       # truncated LJ (no tail correction)

lattice         sc ${rho}
region          box block 0 12 0 12 0 12   # cubic -> Lx == Ly == Lz
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rcut}
pair_coeff      1 1 1.0 1.0

neighbor        0.3 bin
neigh_modify    every 10 delay 0 check yes
comm_modify     cutoff 6.5             # so the rdf can reach r = 6 sigma

fix             1 all nvt temp ${temp} ${temp} 1.0
timestep        0.002

# equilibration

thermo          2000
run             20000

# production: accumulate time-averaged S_ij(k) and g(r)

compute         sf  all structure/factor/2d ${kmax} ${nbins}
compute         rdf all rdf 200 1 1 cutoff 6.0

fix             sfavg  all ave/time 10 5000 50000 c_sf[*]  mode vector file sf_bulk.out
fix             rdfavg all ave/time 10 5000 50000 c_rdf[*] mode vector file rdf_bulk.out

run             500000
print           "BOX Lx $(lx) Lz $(lz) rho $(count(all)/vol)"
