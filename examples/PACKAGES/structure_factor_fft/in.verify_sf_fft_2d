# verify compute structure/factor/2d/fft vs structure/factor/2d (direct DFT)
units           lj
atom_style      atomic
lattice         fcc 0.6
region          box block 0 8 0 8 0 24          # square xy, elongated z (slab)
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 1.0 4321 dist gaussian

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

fix             1 all nve
timestep        0.005
run             200                              # disorder -> nontrivial S_ij(k)

compute         s2  all structure/factor/2d     5 8
compute         s2f all structure/factor/2d/fft 5 8

fix             d1 all ave/time 1 1 1 c_s2[1]  c_s2[2]  c_s2[3]  c_s2[4]  c_s2[5]  mode vector file s2_dft.out
fix             d2 all ave/time 1 1 1 c_s2f[1] c_s2f[2] c_s2f[3] c_s2f[4] c_s2f[5] mode vector file s2_fft.out
run             1
