# fcc Cu with ACE product, box length variable $L for weak-scaling studies.
#
# Making the box length a variable lets $L be non-integer so the atom count can
# be tuned continuously at constant density.  A non-integer $L truncates the fcc
# lattice incommensurately with the periodic box, so atoms and their wrapped
# images can overlap, producing huge forces and lost atoms.  The block below
# mitigates this without changing the density or deleting atoms:
#   1. a tiny random displacement breaks exact (zero-separation) degeneracy so
#      the soft force is non-zero (soft F vanishes at r=0),
#   2. a ramped pair_style soft push-off gently separates overlapping pairs,
#   3. a minimization with the real ACE potential relaxes the configuration.
# Override the box size on the command line, e.g.  lmp -var L 4.5 -in in.pace.product.scale

variable        L index 4

units           metal
atom_style      atomic

neighbor        0.3 bin
neigh_modify    every 2 delay 10 check yes

variable        a equal 3.597
lattice         fcc $a
region          box block 0 $L 0 $L 0 $L
create_box      1 box
create_atoms    1 box

mass            1 26.98

# --- overlap mitigation (only does work when the box is incommensurate) ---
displace_atoms  all random 0.01 0.01 0.01 12345 units box

pair_style      soft 2.5
pair_coeff      * * 0.0
variable        pre equal ramp(0,100)
fix             push all adapt 1 pair soft a * * v_pre
fix             lim all nve/limit 0.05
thermo          50
run             1000
unfix           push
unfix           lim
reset_timestep  0

# --- real potential + relaxation ---
pair_style      pace product
pair_coeff      * * Cu-PBE-core-rep.ace Cu
min_style       cg
minimize        1e-8 1e-8 1000 10000

# --- dynamics ---
velocity        all create 300 8728 loop geom
timestep        0.0005
fix             1 all nve

compute         eatom all pe/atom
compute         energy all reduce sum c_eatom
variable        delenergy equal c_energy-pe

compute         satom all stress/atom NULL
compute         str all reduce sum c_satom[1] c_satom[2] c_satom[3]
variable        delpress equal -(c_str[1]+c_str[2]+c_str[3])/(3*vol)-press

thermo          10
thermo_style    custom step temp epair etotal press v_delenergy v_delpress

run             100
