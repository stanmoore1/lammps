# Planar long-range dispersion: NVE energy conservation
# LJ liquid-vapor slab (1267 atoms), fully periodic, inhomogeneous in z.
# Full LJ to rcut+Delta from pair lj/cut/dispplanar, long-range 1/r^6
# tail from the 1-D z Fourier sum of ewald/disp/planar.

units           lj
atom_style      atomic
boundary        p p p

read_data       data.lj_slab

pair_style      lj/cut/dispplanar 3.0 0.6
pair_coeff      1 1 1.0 1.0

kspace_style    ewald/disp/planar 1.0e-5

velocity        all create 0.85 12345 mom yes rot yes dist gaussian

fix             1 all nve

thermo_style    custom step temp pe etotal press
thermo          100

timestep        0.004

run             2000
