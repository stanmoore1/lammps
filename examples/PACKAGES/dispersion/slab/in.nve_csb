# Energy conservation (NVE) with the compact-switch dispersion slab Ewald.
units           lj
atom_style      atomic
boundary        p p p
read_data       data.lj_slab
pair_style      lj/cut/dispswitch 3.6 0.6
pair_coeff      1 1 1.0 1.0
kspace_style    ewald/disp/slab 1.0e-4
kspace_modify   damp compact
velocity        all create 0.85 4928 mom yes
fix             1 all nve
timestep        0.004
thermo_style    custom step temp pe etotal press
thermo          50
run             500
