units lj
atom_style atomic
boundary p p p
variable N index 3 5 7
variable A index 1.0e-4 1.0e-5 1.0e-6
label louter
  label linner
    clear
    read_data data.lj_slab
    velocity all set 0.0 0.0 0.0
    pair_style lj/cut/dispswitch 2.5 0.5
    pair_coeff 1 1 1.0 1.0
    kspace_style ewald/disp/slab ${A}
    kspace_modify damp compact disp/switch/order ${N}
    print "=== order=${N} acc=${A} ==="
    run 0
  next A
  jump in.km.tmp linner
  variable A delete
  variable A index 1.0e-4 1.0e-5 1.0e-6
next N
jump in.km.tmp louter
