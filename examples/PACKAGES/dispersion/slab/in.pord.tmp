units lj
atom_style atomic
boundary p p p
variable N index 3 5 7
label loop
clear
read_data data.lj_slab
velocity all set 0.0 0.0 0.0
pair_style lj/cut/dispswitch 2.5 0.5
pair_coeff 1 1 1.0 1.0
kspace_style pppm/disp/slab 1.0e-4
kspace_modify damp compact disp/switch/order ${N}
thermo_style custom step pe pzz
print "=== pppm order ${N} ==="
run 0
print "PORD order=${N} PE=$(pe:%.8f)"
next N
jump in.pord.tmp loop
