units lj
atom_style atomic
boundary p p p
variable D index 0.05 0.1 0.2 0.4 0.8
label loop
clear
read_data data.lj_slab
velocity all set 0.0 0.0 0.0
pair_style lj/cut/dispswitch 3.0 ${D}
pair_coeff 1 1 1.0 1.0
kspace_style ewald/disp/slab 1.0e-4
kspace_modify damp compact
thermo_style custom step pxx pyy pzz
run 0
print "OFF D=${D}  dPxx=$(pxx-(-0.455966):%.5f)  scalar_off=$((pxx+pyy+pzz)/3-(-0.516830):%.5f)"
next D
jump in.voff loop
