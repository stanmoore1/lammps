units lj
atom_style atomic
boundary p p p
variable N index 1 2 3 5 7
label loop
clear
read_data data.lj_slab
velocity all set 0.0 0.0 0.0
pair_style lj/cut/dispswitch 2.5 0.5
pair_coeff 1 1 1.0 1.0
kspace_style ewald/disp/slab 1.0e-8
kspace_modify damp compact disp/switch/order ${N} kmax 250
thermo_style custom step pe
run 0
print "CONVERGED order=${N} PE=$(pe:%.9f)"
next N
jump in.oc.tmp loop
