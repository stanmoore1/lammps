units lj
atom_style atomic
boundary p p p
variable K index 105 300 800 2000
label loop
clear
read_data data.lj_slab
velocity all set 0.0 0.0 0.0
pair_style lj/cut/dispswitch 3.0 0.3
pair_coeff 1 1 1.0 1.0
kspace_style ewald/disp/slab 1.0e-4
kspace_modify damp compact kmax ${K}
thermo_style custom step pxx pyy pzz
run 0
print "Kmax=${K}  Pxx=$(pxx:%.6f)  (exact -0.455966)"
next K
jump in.kconv loop
