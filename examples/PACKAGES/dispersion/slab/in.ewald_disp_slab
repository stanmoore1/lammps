# Slab-based (SB) Ewald long-range dispersion for a planar LJ liquid-vapor slab.
# The slab kspace style pairs with a plain-cutoff LJ pair style: the pair does
# the full LJ to r_cut, and ewald/disp/slab adds the r>r_cut dispersion tail
# with a 1-D (z) Fourier sum.  Fully periodic; no EW3DC kspace_modify slab.

units           lj
atom_style      atomic
boundary        p p p

read_data       data.lj_slab

pair_style      lj/cut 3.0
pair_coeff      1 1 1.0 1.0

# damped (SSB) slab Ewald; binned real-space correction (fast).
# use "kspace_modify damp no" for the non-damped variant (no correction term).
kspace_style    ewald/disp/slab 1.0e-4
kspace_modify   damp yes corr bin

# long-range surface tension gamma = (Lz/2)(P_zz - (P_xx+P_yy)/2)
variable        lz equal lz
variable        gamma equal 0.5*v_lz*(pzz-0.5*(pxx+pyy))
thermo_style    custom step temp pe etotal press pxx pyy pzz v_gamma
thermo          50

velocity        all create 0.85 4928 mom yes
fix             1 all nve
timestep        0.004
run             500
