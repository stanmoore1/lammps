units           lj
atom_style      sphere
lattice         fcc 0.5
region          box block 0 6 0 6 0 6
create_box      1 box
create_atoms    1 box
set             type 1 diameter 1.0 density 1.0
velocity        all create 1.44 87287 loop geom
velocity        all set 0.5 NULL NULL sum yes
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
compute         cc all chunk/atom bin/1d x lower 0.5
compute         tb all temp/chunk cc temp com yes
compute         ts all temp/sphere bias tb
fix             1 all nve/sphere
thermo_style    custom step temp c_ts pe
thermo          10
run             50
