units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 6 0 6 0 6
create_box      1 box
create_atoms    1 box
mass            1 1.0
displace_atoms  all random 0.1 0.1 0.1 12345
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
thermo          10
thermo_style    custom step pe fnorm fmax
min_style       quickmin
minimize        0.0 1.0e-8 100 1000
