# Rerun B: reference profile from a LONG plain lj/cut cutoff with NO kspace, over
# the SAME dumped trajectory. rcut=8.0 < L=10 so LAMMPS ghost atoms include all
# periodic images correctly (no minimum-image limit). The 1/r^6 tail beyond 8 is
# ~1/512, negligible, so this approximates the untruncated LJ that Run A
# (pair + dispersion kspace) reconstructs. pair_modify tail no: local stress must
# not include a global tail correction.

units           lj
atom_style      atomic
boundary        p p p

read_data       ../../examples/PACKAGES/dispersion/planar/data.lj_slab

pair_style      lj/cut 8.0
pair_coeff      1 1 1.0 1.0
pair_modify     tail no

variable        dz      equal 0.1
compute         pB all stress/cartesian z ${dz} NULL 0 ke pair
fix             fB all ave/time 1 1 500 c_pB[*] file ik_longcutB.dat mode vector ave running

thermo          100
rerun           traj.dump first 0 dump x y z vx vy vz
