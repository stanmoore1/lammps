units           lj
atom_style      atomic
boundary        p p p
read_data       ../../examples/PACKAGES/dispersion/planar/data.lj_slab
pair_style      lj/cut/dispplanar 3.0 0.6
pair_coeff      1 1 1.0 1.0
kspace_style    ewald/disp/planar 1.0e-5
velocity        all create 0.85 12345 mom yes rot yes dist gaussian
fix             1 all nve
timestep        0.004
thermo_style    custom step temp pe etotal press
thermo          200
run             40000
