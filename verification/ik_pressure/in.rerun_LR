# Long-range-ONLY reruns over traj.dump, for the dissertation Fig 4.7 reproduction.
# Isolates the kspace (long-range dispersion) contribution to the local pressure:
#   IK contour  : compute stress/cartesian z 0.1 NULL 0 kspace  (pN=Pczz, pT=Pcxx)
#   H  contour  : compute stress/atom NULL kspace + fix ave/chunk (per-atom kspace virial)
# Both give P_N^LR(z) and P_T^LR(z); the density (chunk count) gives rho(z).

units           lj
atom_style      atomic
boundary        p p p
read_data       ../../examples/PACKAGES/dispersion/planar/data.lj_slab
pair_style      lj/cut/dispplanar 3.0 0.6
pair_coeff      1 1 1.0 1.0
kspace_style    ewald/disp/planar 1.0e-5
kspace_modify   corr bin
variable        dz      equal 0.1

# IK long-range only (kspace keyword only -> no ke, no pair)
compute         pIKlr all stress/cartesian z ${dz} NULL 0 kspace
fix             f1 all ave/time 1 1 500 c_pIKlr[*] file ikLR.dat mode vector ave running

# H long-range only (per-atom kspace virial, binned)
compute         sa all stress/atom NULL kspace
compute         cc all chunk/atom bin/1d z lower ${dz} units box
fix             f2 all ave/chunk 1 1 500 cc c_sa[1] c_sa[2] c_sa[3] norm none ave running file hLR.dat

thermo          100
rerun           traj.dump first 0 dump x y z vx vy vz
