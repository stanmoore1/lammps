# Reproduction of the dissertation CPP 2 simulation (Moore, Table 4.1):
#   supercritical LJ fluid, N=2000, T*=1.5, Lz/Lx=2, rho_avg=0.598, dUmax*=9.67,
#   full LJ with Ewald dispersion at rcut=4.0 sigma (ewald/disp/planar),
#   cosine external field U_ext(z)=(dUmax/2) cos(2 pi z/Lz)  (Eq 3.36).
# Box: Lx=Ly=(N/(2 rho))^(1/3)=11.872, Lz=23.744  -> sc lattice 10x10x20 = 2000.

units           lj
atom_style      atomic
boundary        p p p
processors      2 2 1

lattice         sc 0.598
region          box block 0 10 0 10 0 20
create_box      1 box
create_atoms    1 box
mass            1 1
velocity        all create 1.5 12345 mom yes dist gaussian

pair_style      lj/cut/dispplanar 4.0 0.6
pair_coeff      1 1 1.0 1.0
kspace_style    ewald/disp/planar 1.0e-5
kspace_modify   corr bin

# external cosine field, f_z = -dU/dz = (dUmax/2)(2pi/Lz) sin(2pi z/Lz)
#   dUmax=9.67 -> amplitude 4.835 ; 2pi/Lz=0.264627 ; f_amp=1.27947
variable        fz atom 1.27947*sin(0.264627*z)
fix             ext all addforce 0.0 0.0 v_fz
fix             nvt all nvt temp 1.5 1.5 0.5
timestep        0.002

thermo          2000
thermo_style    custom step temp pe etotal pxx pyy pzz

# ---- equilibrate the field-driven density gradient ----
run             100000

# ---- production ----
reset_timestep  0
compute         cc all chunk/atom bin/1d z lower 0.1 units box
fix             dens all ave/chunk 100 200 100000 cc density/number file cpp2_density.dat
dump            dtraj all custom 2000 traj_cpp2.dump id type x y z vx vy vz
dump_modify     dtraj sort id
run             200000
write_restart   cpp2.restart
