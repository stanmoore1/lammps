# Rerun A with corr RAW (exact per-atom shell virial) over the same frames, to
# numerically test the shell (corr) correction for the IK contour: compare the
# IK profile from corr raw vs corr bin vs the long-cutoff ground truth (Run B).

units           lj
atom_style      atomic
boundary        p p p
read_data       ../../examples/PACKAGES/dispersion/planar/data.lj_slab
pair_style      lj/cut/dispplanar 3.0 0.6
pair_coeff      1 1 1.0 1.0
kspace_style    ewald/disp/planar 1.0e-5
kspace_modify   corr raw         # EXACT per-atom shell (vs bin in rerunA)

variable        dz      equal 0.1
compute         pA all stress/cartesian z ${dz} NULL 0 ke pair kspace
fix             fA all ave/time 1 1 500 c_pA[*] file ik_rerunA_raw.dat mode vector ave running

thermo          100
rerun           traj.dump first 0 dump x y z vx vy vz
