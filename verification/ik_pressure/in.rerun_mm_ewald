# Long-range-only profiles for the CPP 2 reproduction (rcut=4.0), over traj_multimode.dump:
#   IK contour: compute stress/cartesian z 0.06 NULL 0 kspace
#   H  contour: compute stress/atom NULL kspace + fix ave/chunk
# CPP 2 box Lz=23.744; kmax=77 so nbins=396 (>2*kmax=154) is fine.
units           lj
atom_style      atomic
boundary        p p p
processors      2 2 1
lattice         sc 0.598
region          box block 0 10 0 10 0 20
create_box      1 box
create_atoms    1 box
mass            1 1
pair_style      lj/cut/dispplanar 4.0 0.6
pair_coeff      1 1 1.0 1.0
kspace_style    ewald/disp/planar 1.0e-5
kspace_modify   corr bin
variable        dz      equal 0.06

compute         pIKlr all stress/cartesian z ${dz} NULL 0 kspace
fix             f1 all ave/time 1 1 500 c_pIKlr[*] file mm_ikLR_ewald.dat mode vector ave running
compute         sa all stress/atom NULL kspace
compute         cc all chunk/atom bin/1d z lower ${dz} units box
fix             f2 all ave/chunk 1 1 500 cc c_sa[1] c_sa[2] c_sa[3] norm none ave running file mm_hLR_ewald.dat

thermo          100
rerun           traj_multimode.dump first 0 dump x y z vx vy vz
