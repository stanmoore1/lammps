units lj
atom_style atomic
boundary p p p
processors * * *
lattice sc 0.598
region box block 0 10 0 10 0 20
create_box 1 box
create_atoms 1 box
mass 1 1
pair_style lj/cut/dispswitch 4.0 0.6
pair_coeff 1 1 1.0 1.0
kspace_style pppm/disp/slab/kk 1.0e-5
variable dz equal 0.06
compute pIK all stress/cartesian z ${dz} NULL 0 kspace
fix f1 all ave/time 1 1 500 c_pIK[*] file slab_ikLR_kk.dat mode vector ave running
compute sa all stress/atom NULL kspace
compute cc all chunk/atom bin/1d z lower ${dz} units box
fix f2 all ave/chunk 1 1 500 cc c_sa[1] c_sa[2] c_sa[3] norm none ave running file slab_hLR_kk.dat
thermo 100
rerun traj_cpp2.dump first 0 dump x y z vx vy vz
