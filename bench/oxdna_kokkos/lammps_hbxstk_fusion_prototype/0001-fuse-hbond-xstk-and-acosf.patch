+
+  deltb[0] = fma(rb_chb[1], delf[2], -rb_chb[2] * delf[1]);
+  deltb[1] = fma(rb_chb[2], delf[0], -rb_chb[0] * delf[2]);
+  deltb[2] = fma(rb_chb[0], delf[1], -rb_chb[1] * delf[0]);
+}
