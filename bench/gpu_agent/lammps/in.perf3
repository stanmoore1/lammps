# oxDNA3 NVE performance run, same settings as the oxDNA-style `input` of make_case.sh
# (T = 0.1, salt 0.5, dt 0.003, LAMMPS skin 1.0 = 2 x verlet_skin 0.5). vars: data, steps
variable steps index 10000
variable potfile index oxdna3_lj.cgdna
units lj
dimension 3
newton on
boundary p p p
atom_style hybrid bond ellipsoid oxdna
atom_modify sort 0 1.0
neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes
read_data ${data}
set atom * mass 3.1575
bond_style oxdna3/fene
bond_coeff * ${potfile}
special_bonds lj 0 1 1
pair_style hybrid/overlay oxdna3/excv oxdna3/stk oxdna3/hbond oxdna3/xstk oxdna3/coaxstk oxdna3/dh
pair_coeff * * oxdna3/excv    ${potfile}
pair_coeff * * oxdna3/stk     0.1 ${potfile}
pair_coeff * * oxdna3/hbond   ${potfile}
pair_coeff 1 4 oxdna3/hbond   ${potfile}
pair_coeff 2 3 oxdna3/hbond   ${potfile}
pair_coeff * * oxdna3/xstk    ${potfile}
pair_coeff * * oxdna3/coaxstk ${potfile}
pair_coeff * * oxdna3/dh      0.1 0.5 ${potfile} half_charged_ends yes
fix 1 all nve/asphere
timestep 0.003
velocity all create 0.1 12345 dist gaussian
thermo_style custom step pe ke etotal
thermo_modify norm yes
thermo ${steps}
run ${steps}
