# oxDNA3 8bp duplex benchmark -- runnable by oxdna_kokkos, oxdna_kokkos_lammps and the standalone oxDNA.
# Run from this directory:  ../../build/oxdna_kokkos_lammps input_dna3
# test_dna3.conf is test.conf relaxed with the standalone oxDNA3 model
# (the first bond of the oxDNA1 test.conf lies outside the oxDNA3 FENE range).
backend = CPU
sim_type = MD
interaction_type = DNA3
use_average_seq = false
seq_dep_file = ../../../oxdna_kokkos/params/oxDNA3_sequence_dependent_parameters.txt
salt_concentration = 0.5
T = 0.1
dt = 0.002
steps = 5000
thermostat = brownian
newtonian_steps = 103
diff_coeff = 2.5
verlet_skin = 0.5
print_energy_every = 500
seed = 12345
refresh_vel = 1
timing = 0
time_scale = linear
restart_step_counter = 1
trajectory_file = trajectory_dna3.dat
energy_file = energy_dna3.dat
lastconf_file = last_conf_dna3.dat
print_conf_interval = ${$(steps) / 10}
topology = test.top
conf_file = test_dna3.conf
