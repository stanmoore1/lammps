# proves pair brownian/kk seeded its RNG pool from an uninitialised seed
# (the pool was built in the constructor, before settings() parsed the seed),
# so every seed produced the same stream.  compare seed1 vs seed2 output.
units           lj
atom_style      sphere
dimension       3
lattice         sc 0.05
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box
set             type 1 diameter 1.0 density 1.0
velocity        all set 0.0 0.0 0.0
pair_style      brownian 1.0 1 1 1.1 2.5 1.0 98765
pair_coeff      * *
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check no
timestep        0.0001
fix             1 all nve/sphere
compute         fsq all reduce sumsq fx fy fz
thermo_style    custom step c_fsq[1] c_fsq[2] c_fsq[3]
thermo          5
run             5
