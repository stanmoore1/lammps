units           lj
atom_style      full
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box bond/types 1 extra/bond/per/atom 12 extra/special/per/atom 40
create_atoms    1 box
mass            1 1.0
region          neg block 0 2 INF INF INF INF
set             type 1 charge 0.5
set             region neg charge -0.5
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut/coul/dsf 0.05 2.5 2.5
pair_coeff      1 1 1.0 1.0
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check no
bond_style      zero
bond_coeff      1
create_bonds    many all all 1 1.0 1.25
special_bonds   lj 0.5 0.5 0.5 coul 0.5 0.5 0.5
fix             1 all nve
thermo_style    custom step temp epair ecoul etotal press
thermo          50
run             50
