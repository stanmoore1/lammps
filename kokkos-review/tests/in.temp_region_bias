units           lj
atom_style      sphere
lattice         fcc 0.8442
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box
set             type 1 diameter 1.0 density 1.0
velocity        all create 1.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check no
region          half block 0 2.5 INF INF INF INF
compute         tr all temp/region half
compute         ts all temp/sphere bias tr
fix             1 all nve
thermo_style    custom step temp c_ts
thermo          50
run             50
