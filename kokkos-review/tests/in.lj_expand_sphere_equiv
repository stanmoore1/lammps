# lj/expand/sphere with every radius equal to d/2 is by construction the same
# potential as lj/expand with shift = d.  The two thermo lines below must agree
# in BOTH columns.  Upstream they agree on energy and disagree on the virial and
# on the force, because lj/expand/sphere multiplied by rshift where the gradient
# needs a division.
units           lj
atom_style      sphere
lattice         fcc 0.2
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
set             type 1 diameter 0.5 density 1.0
velocity        all create 1.0 87287 loop geom
displace_atoms  all random 0.15 0.15 0.15 12345
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check no
compute         fsq all reduce sumsq fx fy fz
thermo_style    custom step epair c_fsq[1] c_fsq[2] c_fsq[3]

pair_style      lj/expand 2.5
pair_coeff      1 1 1.0 1.0 0.5
run             0

pair_style      lj/expand/sphere 2.5
pair_coeff      1 1 1.0 1.0
run             0
