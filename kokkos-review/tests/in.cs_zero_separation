# two exactly coincident charges, no bonds, so the pair IS in the neighbour list
# at r = 0 with a full-strength factor.  The Born r^-8 term at the EPSILON floor
# overflows to inf in single precision unless the floor is precision-aware.
units           metal
atom_style      full
region          box block 0 20 0 20 0 20
create_box      2 box
create_atoms    1 single 5.0 5.0 5.0
create_atoms    2 single 5.0 5.0 5.0
mass            * 10.0
set             type 1 charge  1.0
set             type 2 charge -1.0
pair_style      born/coul/dsf/cs 0.1 10.0
pair_coeff      * * 1.0 1.0 0.0 1.0 1.0
thermo_style    custom step epair ecoul press
run             0
